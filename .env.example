# ── AI layer ───────────────────────────────────────────────────────────────
# Anthropic API key for brand analysis + content generation.
# If unset, the app falls back to deterministic mock output so it still runs.
ANTHROPIC_API_KEY=

# ── Database (Postgres) ──────────────────────────────────────────────────────
# The shipped scaffold uses an in-memory store; point this at Postgres and run
# `prisma migrate` to make it durable + multi-tenant. See prisma/schema.prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_cmo

# ── Redis (job queue + cache) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Clerk / NextAuth) ──────────────────────────────────────────────────
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Per-agent integrations (optional; agents degrade to drafting-only) ────────
# SERPAPI_KEY=
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TWITTER_BEARER_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
